<Window x:Class="MCDownloader.FloatingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="80" Height="80"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize">

    <Border Width="72" Height="72" CornerRadius="36"
            Background="#7C9EFF" MouseLeftButtonDown="Border_MouseLeftButtonDown"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="PercentText" Text="--" Foreground="White"
                       FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="SpeedText" Text="速度" Foreground="#D0D8FF"
                       FontSize="10" HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>