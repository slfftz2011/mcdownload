<Window x:Class="MCDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCDownloader" Height="700" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#2A2A3C"/>
        <SolidColorBrush x:Key="Accent" Color="#7C9EFF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#EAEAF0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9A9AB0"/>
        <SolidColorBrush x:Key="InputBg" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="Divider" Color="#3A3A50"/>

        <Style TargetType="Border" x:Key="CardBorder">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：版本新闻流 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="版本动态"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ListBox x:Name="VersionList"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             SelectionChanged="VersionList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="11"
                                               Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 右侧：详情 + 自定义下载 + 进度 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock x:Name="DetailTitle" Text="选择一个版本"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="DetailSub" Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondary}"/>

                    <Button x:Name="InstallBtn" Content="安装此版本"
                            Margin="0,24,0,0" Padding="24,8" HorizontalAlignment="Left"
                            Background="{StaticResource Accent}" Foreground="#1E1E2E"
                            BorderThickness="0" FontWeight="SemiBold"
                            Click="InstallBtn_Click" IsEnabled="False"/>

                    <Border Height="1" Background="{StaticResource Divider}" Margin="0,20,0,0"/>

                    <!-- 自定义高速下载 -->
                    <TextBlock Text="自定义高速下载"
                               Foreground="{StaticResource TextPrimary}"
                               FontSize="14" FontWeight="SemiBold" Margin="0,16,0,4"/>
                    <TextBlock Text="粘贴任意 http/https 直链，支持大文件分块下载与哈希校验"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11" Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomUrlBox" Grid.Column="0"
                                 Padding="10,6"
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource Divider}"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"/>
                        <Button x:Name="CustomDownloadBtn" Grid.Column="1"
                                Content="下载" Margin="8,0,0,0"
                                Padding="20,6"
                                Background="{StaticResource Accent}" Foreground="#1E1E2E"
                                BorderThickness="0" FontWeight="SemiBold"
                                Click="CustomDownloadBtn_Click"/>
                    </Grid>

                    <!-- 哈希校验 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="HashAlgoBox" Grid.Column="0" Width="110"
                                  SelectionChanged="HashAlgoBox_SelectionChanged">
                            <ComboBoxItem Content="不校验" IsSelected="True"/>
                            <ComboBoxItem Content="SHA-1"/>
                            <ComboBoxItem Content="SHA-256"/>
                        </ComboBox>
                        <TextBox x:Name="HashHexBox" Grid.Column="1" Margin="8,0,0,0"
                                 Padding="10,6"
                                 Background="{StaticResource InputBg}"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderBrush="{StaticResource Divider}"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 FontSize="12"
                                 IsEnabled="False"
                                 ToolTip="粘贴完整十六进制哈希"/>
                    </Grid>

                    <!-- 进度 -->
                    <ProgressBar x:Name="MainProgress" Height="6" Margin="0,24,0,0"
                                 Foreground="{StaticResource Accent}"
                                 Background="{StaticResource Divider}"
                                 BorderThickness="0"/>
                    <TextBlock x:Name="ProgressText" Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" Background="#161622" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <Button Grid.Column="1" Content="悬浮球" Padding="16,4"
                        Background="#2A2A3C" Foreground="{StaticResource TextSecondary}"
                        BorderThickness="0" Click="FloatBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>